# docker compose 설정. `cp .env.example .env` 후 값을 바꾸세요.
POSTGRES_DB=study_invest
POSTGRES_USER=study
POSTGRES_PASSWORD=change-me

# pgAdmin 전용 DB 역할(PgBouncer pgAdmin 풀, 세션 모드·최대 5연결). DB 첫 기동 때 만들어진다.
PGADMIN_DB_USER=pgadmin
PGADMIN_DB_PASSWORD=change-me-too
# pgAdmin 웹 로그인(http://localhost:5050)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-three

# 앱 연결 풀 크기(앱 SQLAlchemy 풀 = PgBouncer 풀). docs/dev/db-pools.md의 예산을 지킬 것.
API_POOL_SIZE=20
BATCH_POOL_SIZE=2
# PostgreSQL 최대 연결. (API_POOL_SIZE+5) + BATCH_POOL_SIZE + 5 + 1 + 3 이상이어야 PgBouncer가 시작한다.
PG_MAX_CONNECTIONS=50

# 관리자 백오피스(/admin) 접속 키. 충분히 긴 임의 문자열로 설정하세요.
STUDY_INVEST_ADMIN_KEY=change-me-to-a-long-random-string
# 1이면 백엔드가 09:00 공시·18:00 정산 배치를 자동 실행한다.
STUDY_INVEST_SCHEDULER=1
# 이벤트 기간(YYYY-MM-DD, 양 끝 포함). 비우면 규격서 기간 2026-10-06 ~ 2026-10-16.
# 테스트·QA 서버에서 실제 기간 전에 거래·인증·정산을 돌려 볼 때만 지정한다.
STUDY_INVEST_EVENT_START=
STUDY_INVEST_EVENT_END=
# 앱 시계 배속. 비우면 실제 시계. 테스트·QA 서버에서만 지정한다.
# 24면 실제 1시간이 이벤트 하루다(매시 22분 30초 공시, 45분 정산). 공시·정산·장 운영·인증 마감이 모두 따른다.
# TIME_ORIGIN은 이벤트 첫날 00:00이 시작되는 실제 시각(ISO 8601, 시간대가 없으면 KST).
# 예: STUDY_INVEST_TIME_SCALE=24, STUDY_INVEST_TIME_ORIGIN=2026-10-01T16:00
STUDY_INVEST_TIME_SCALE=
STUDY_INVEST_TIME_ORIGIN=
# 학교 메일 인증 코드 발송(SMTP). 비우면 메일 대신 백엔드 로그로 남는다(로컬 개발 전용, 운영 금지).
# Gmail: 발송 전용 계정을 만들고 2단계 인증 → 앱 비밀번호를 만들어 SMTP_PASSWORD에 넣는다.
STUDY_INVEST_SMTP_HOST=
STUDY_INVEST_SMTP_PORT=587
STUDY_INVEST_SMTP_SECURITY=starttls
STUDY_INVEST_SMTP_USERNAME=
STUDY_INVEST_SMTP_PASSWORD=
# 보내는 주소. 비우면 SMTP_USERNAME. Gmail SMTP는 로그인한 계정 주소여야 한다.
STUDY_INVEST_MAIL_FROM=
# 최근 24시간 인증 메일 상한. 발송 계정 한도보다 낮게(Gmail 개인 계정 약 500통/일).
STUDY_INVEST_MAIL_DAILY_LIMIT=400
# 1이면 관리자 > 배치·정산에 'QA 도구'가 생겨, 시각과 무관하게 가격을 바로 변동시킬 수 있다.
# 테스트·QA 서버에서만 켠다. 운영에서는 반드시 0(이벤트가 시계를 앞질러 되돌릴 수 없다).
STUDY_INVEST_QA_TOOLS=0
# 1이면 QA 무제한 모드: STUDY_INVEST_EVENT_END를 무시하고 시작일 이후 끝없이 공시·정산·회차가 이어진다.
# 가격 추세를 길게 보려면 QA_TOOLS의 '지금 가격 변동시키기' 버튼이나 TIME_SCALE과 함께 쓴다.
# 테스트·QA 서버에서만 켠다. 운영에서는 반드시 0.
STUDY_INVEST_QA_UNLIMITED=0
BACKEND_PORT=8000
WEB_PORT=8080
# 공유 미리보기용 공개 웹 주소(경로 제외). 로컬에서는 비워도 된다. 변경 후 프론트엔드를 다시 빌드한다.
# 예: https://study.example.com
VITE_SITE_URL=
PGADMIN_PORT=5050
