# docker compose 설정. `cp .env.example .env` 후 값을 바꾸세요.
POSTGRES_DB=study_invest
POSTGRES_USER=study
POSTGRES_PASSWORD=change-me

# pgAdmin 전용 DB 역할(PgBouncer pgAdmin 풀, 세션 모드·최대 5연결). DB 첫 기동 때 만들어진다.
PGADMIN_DB_USER=pgadmin
PGADMIN_DB_PASSWORD=change-me-too
# pgAdmin 웹 로그인(http://localhost:5050)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-three

# 앱 연결 풀 크기(앱 SQLAlchemy 풀 = PgBouncer 풀). docs/dev/db-pools.md의 예산을 지킬 것.
API_POOL_SIZE=20
BATCH_POOL_SIZE=2
# PostgreSQL 최대 연결. (API_POOL_SIZE+5) + BATCH_POOL_SIZE + 5 + 1 + 3 이상이어야 PgBouncer가 시작한다.
PG_MAX_CONNECTIONS=50

# 관리자 백오피스(/admin) 접속 키. 충분히 긴 임의 문자열로 설정하세요.
STUDY_INVEST_ADMIN_KEY=change-me-to-a-long-random-string
# 1이면 백엔드가 09:00 공시·18:00 정산 배치를 자동 실행한다.
STUDY_INVEST_SCHEDULER=1
# 이벤트 기간(YYYY-MM-DD, 양 끝 포함). 비우면 규격서 기간 2026-10-06 ~ 2026-10-16.
# 테스트·QA 서버에서 실제 기간 전에 거래·인증·정산을 돌려 볼 때만 지정한다.
STUDY_INVEST_EVENT_START=
STUDY_INVEST_EVENT_END=
BACKEND_PORT=8000
WEB_PORT=8080
PGADMIN_PORT=5050
