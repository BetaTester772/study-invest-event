# docker compose 설정. `cp .env.example .env` 후 값을 바꾸세요.
POSTGRES_DB=study_invest
POSTGRES_USER=study
POSTGRES_PASSWORD=change-me
# 관리자 백오피스(/admin) 접속 키. 충분히 긴 임의 문자열로 설정하세요.
STUDY_INVEST_ADMIN_KEY=change-me-to-a-long-random-string
# 1이면 백엔드가 09:00 공시·18:00 정산 배치를 자동 실행한다.
STUDY_INVEST_SCHEDULER=1
BACKEND_PORT=8000
WEB_PORT=8080
